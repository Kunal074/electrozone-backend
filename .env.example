# ─────────────────────────────────────────
# ElectroZone Backend — Environment Variables
# ─────────────────────────────────────────
# Yeh file COPY karo aur naam rakho: .env
# KABHI .env ko git mein mat daalna!
# ─────────────────────────────────────────
# gurudev@123
# ── SERVER ──
PORT=5000
NODE_ENV=development

# ── DATABASE ──
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE

DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/electrozone"

# ── JWT SECRETS ──
# Strong random string — change karo!
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY="24h"
JWT_REFRESH_EXPIRY="30d"

# ── RAZORPAY (Payment) ──
# razorpay.com pe account banao — free signup
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxx"

# ── CLOUDINARY (Image Upload) ──
# cloudinary.com pe free account banao
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── TWILIO (SMS OTP) ──
# twilio.com pe account banao
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# ── FRONTEND URL (CORS ke liye) ──
FRONTEND_URL="http://localhost:3000"

# ── SUPER ADMIN (pehla admin create karne ke liye) ──
ADMIN_PHONE="9999999999"
ADMIN_PASSWORD="admin123_change_this!"
